# Zmienne środowiskowe (lista jak w README). Tylko nazwy — wartości wpisz w .env.local (git-ignored).
# Lokalny stack (`npm run db:start`) — wartości z wyjścia `supabase status`, nie wklejaj ich tutaj:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key z `supabase status`>
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key z `supabase status`>
#   baza: postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=
P24_SANDBOX=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_MARKETING_FROM_EMAIL=
RESEND_MARKETING_FROM_NAME=
CRON_SECRET=
ADMIN_USER=
ADMIN_PASS=
